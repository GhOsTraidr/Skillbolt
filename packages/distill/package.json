{
  "name": "@skillbolt/distill",
  "version": "1.0.2",
  "description": "Distill AI agent conversations into reusable Skills - Part of Skillbolt",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "skill-distill": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@skillbolt/core": "^1.0.2",
    "@anthropic-ai/sdk": "^0.30.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.0",
    "yaml": "^2.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TacoSkill/Skill-Kit.git",
    "directory": "packages/distill"
  },
  "keywords": [
    "skill",
    "claude",
    "codex",
    "cursor",
    "ai",
    "agent",
    "cli",
    "distill",
    "conversation",
    "llm"
  ],
  "license": "MIT"
}