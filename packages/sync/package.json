{
  "name": "@skillbolt/sync",
  "version": "1.0.2",
  "description": "Cross-device Skill synchronization with cloud backends for Skillbolt",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "skill-sync": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@skillbolt/core": "^1.0.2",
    "@skillbolt/registry": "^1.0.2",
    "@supabase/supabase-js": "^2.39.0",
    "commander": "^11.1.0",
    "chokidar": "^3.5.3",
    "micromatch": "^4.0.5"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.6",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TacoSkill/Skill-Kit.git",
    "directory": "packages/sync"
  },
  "keywords": [
    "skill",
    "sync",
    "cloud",
    "supabase",
    "ai",
    "agent"
  ],
  "license": "MIT"
}