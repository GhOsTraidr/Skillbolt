{
  "name": "@skillbolt/cli",
  "version": "1.2.4",
  "description": "Unified CLI for Skillbolt - AI Agent Skill ecosystem toolset",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "skill": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@skillbolt/core": "^1.0.2",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "open": "^10.1.0"
  },
  "optionalDependencies": {
    "@skillbolt/lint": "^1.0.2",
    "@skillbolt/init": "^1.0.2",
    "@skillbolt/registry": "^1.0.2",
    "@skillbolt/distill": "^1.0.2",
    "@skillbolt/convert": "^1.0.2",
    "@skillbolt/test": "^1.0.2",
    "@skillbolt/sync": "^1.0.2",
    "@skillbolt/analytics": "^1.0.2",
    "@skillbolt/compose": "^1.0.2",
    "@skillbolt/doc": "^1.0.2",
    "@skillbolt/tree": "^1.0.1",
    "@skillbolt/search": "^1.0.1",
    "@skillbolt/execute": "^1.0.1",
    "@skillbolt/web-ui": "^1.0.1",
    "@skillbolt/openclaw": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TacoSkill/Skill-Kit.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "skill",
    "cli",
    "ai",
    "agent",
    "skill-kit",
    "toolset"
  ],
  "license": "MIT"
}