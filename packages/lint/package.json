{
  "name": "@skillbolt/lint",
  "version": "1.0.2",
  "description": "SKILL.md format linter for Skillbolt - check and fix your AI agent skills",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "skill-lint": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@skillbolt/core": "^1.0.2",
    "commander": "^12.0.0",
    "cosmiconfig": "^9.0.0",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TacoSkill/Skill-Kit.git",
    "directory": "packages/lint"
  },
  "keywords": [
    "skill",
    "lint",
    "linter",
    "ai",
    "agent",
    "markdown",
    "skill.md"
  ],
  "license": "MIT"
}